# Fetched and derived data. Everything here is reproducible from the registries
# in src/economic_regime_forecasting/configuration/ by running `forecast fetch-data`.
# Nothing under .cache/ is ever committed.
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling state
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Notebook outputs are stripped before commit; see docs/RUNNING.md.
# Generated run artifacts (the manifest that describes them IS committed).
artifacts/**
!artifacts/.gitkeep

# Local machine
.DS_Store
.env
.env.*

# Crucible working memory: unit state and the graphify index. Rebuilt on demand;
# knowledge that should outlive a session is promoted to docs/adr/.
.plan/

# Machine-local Claude settings, and the single-use thaw token. Personal, not
# policy — the rest of .claude/ IS tracked, because a hook that only exists on
# one laptop is not a gate. See docs/TOOLING.md.
.claude/settings.local.json
.claude/*.local.json
.claude/thaw-token.json

# Bellows stakeholder heuristics are personal decision notes. This repository is
# public (verified 2026-09-10, see .claude/bellows.json), so they must never be
# committed. The directory is empty today; this keeps the first file written
# there from being published by an ordinary `git add`.
research/stakeholder/
